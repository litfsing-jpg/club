<div class="iiclub-material-player-wrapper">
  {{#if this.videoTitle}}
    <div class="iiclub-player-header">
      <h3 class="iiclub-player-title">{{this.videoTitle}}</h3>
      <button type="button" class="btn btn-primary iiclub-resume-btn" {{on "click" this.resumePlayback}}>
        {{d-icon "play"}} {{this.resumeButtonLabel}}
      </button>
    </div>
  {{/if}}

  <div class="iiclub-iframe-container" style="height: {{this.iframeHeight}}px;">
    <iframe
      src={{this.embedUrl}}
      width="100%"
      height="100%"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
</div>

